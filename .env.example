# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django secret key — generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (include your Vercel domain)
# e.g. ALLOWED_HOSTS=your-project.vercel.app,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary — get this from your Cloudinary dashboard
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Neon PostgreSQL variables for production
POSTGRES_URL=postgresql://user:password@host/database?channel_binding=require&sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@host/database?channel_binding=require&sslmode=require
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=database
POSTGRES_URL_NO_SSL=postgresql://user:password@host/database
POSTGRES_PRISMA_URL=postgresql://user:password@host/database?channel_binding=require&connect_timeout=15&sslmode=require

