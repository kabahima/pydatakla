# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django secret key — generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (include your Vercel domain)
# e.g. ALLOWED_HOSTS=your-project.vercel.app,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary — get this from your Cloudinary dashboard
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Database URL — SQLite for local dev, Postgres for production
# Postgres example: postgres://user:password@host:5432/dbname
# Leave unset to use SQLite locally
DATABASE_URL=DATABASE_URL=postgresql://neondb_owner:npg_z7gLI9aihcsq@ep-weathered-unit-amrhfr35-pooler.c-5.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

